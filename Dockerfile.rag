FROM python:3.14-slim

WORKDIR /app

# System dependencies + security upgrades
RUN apt-get update && \
    apt-get upgrade -y && \
    apt-get install -y --no-install-recommends \
    build-essential \
    curl && \
    rm -rf /var/lib/apt/lists/*

# Copy requirements and install Python deps (upgrade pip+setuptools first: patches setuptools CVEs)
COPY requirements.txt /app/
RUN pip install --no-cache-dir --upgrade pip setuptools && \
    pip install --no-cache-dir -r requirements.txt

# Remove the build toolchain now that deps are compiled
RUN apt-get purge -y --auto-remove build-essential && \
    rm -rf /var/lib/apt/lists/*

# Copy Python code
COPY main.py /app/

# Create necessary directories
RUN mkdir -p /app/data /app/data/chromadb

# Run as a non-root user that owns /app
RUN useradd -u 1000 -m -d /home/appuser appuser && \
    chown -R appuser:appuser /app /home/appuser
ENV HOME=/home/appuser

# Expose port for FastAPI
EXPOSE 8000

# Health check
HEALTHCHECK --interval=30s --timeout=30s --start-period=10s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

USER appuser

# Run the application with auto-initialization
CMD ["python", "main.py", "--host", "0.0.0.0", "--port", "8000", "--initialize"]
